# Modelo das variáveis de ambiente do app.
# Copie este arquivo para .env.local e preencha com os valores do seu projeto no Supabase:
#   supabase.com > projeto app-financeiro > Project Settings > API (ou botão "Connect")
# O .env.local nunca vai para o GitHub (está no .gitignore).

# Endereço do projeto, ex.: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública ("publishable", começa com sb_publishable_). Pode ir para o navegador:
# o acesso aos dados é limitado pelas regras de isolamento por usuário no banco.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NÃO coloque aqui a chave "service_role" / "secret" nem a senha do banco.
